<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <Author>Kyuros1</Author>
    <Name>Beast Keeper</Name>
    <Punchline>Stop re-picking your Beastmaster familiars before every Crucible battle.</Punchline>
    <Description>picks the first 3 beasts / remembers your beast selection and sets it by default, as it should have been</Description>
    <Changelog>First release.</Changelog>
    <Tags>beastmaster;crucible;familiar;battlehorn</Tags>
    <RepoUrl>https://github.com/Kyuros1/BeastKeeper</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/Kyuros1/BeastKeeper/main/images/icon.png</IconUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shown by Dalamud in the plugin installer (Cu Sith). -->
    <Content Include="..\images\icon.png" Link="images\icon.png" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
